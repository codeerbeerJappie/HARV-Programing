FeelixEffect effect1 = FeelixEffect(torqueinverse_config, data_torqueinverse);

#define NR_OF_EFFECTS 3
FeelixEffect* effects[NR_OF_EFFECTS] = { &effect0, &effect1, &effect2 };

/* ---- scaling: pitch -> strength of the velocity effect ---- */
const float PITCH_FULL = 90.0;
const float SCALE_MIN  = 0.3;
const float SCALE_MAX  = 2.0;

void applyScale(float s) {
    effect0.scale.y = s;
}

/* ---- data from the master ---- */
volatile float  pitch = 0.0;     // degrees, callback index 0
volatile int8_t fastFlag = 0;    // 1 = moving fast, callback index 2

int16_t data = 0;
char arr[6];

enum Mode { MODE_VELOCITY, MODE_TORQUE, MODE_RETURN };
Mode mode = MODE_VELOCITY;
float scaleNow = 1.0;
float torqueAnchorDeg = 0.0;     // angle the shaft had when fast movement was detected
unsigned long returnStart = 0;

unsigned long prevTime = 0;
const uint16_t timeInterval = 100;

void callBack_receiveFloat() {
    pitch = feelix.slave.receiveFloat();
    feelix.toggleLED(STM32_LED_ORANGE);
}

void callBack_receiveInt() {
    data = feelix.slave.receiveInt();
}

void callBack_receiveByte() {
    fastFlag = (feelix.slave.receiveByte() != 0) ? 1 : 0;
    feelix.toggleLED(STM32_LED_ORANGE);
}

void callBack_receiveCharArray() {
    feelix.slave.receiveCharArray(arr, sizeof(arr));
}

const functionPtr callbackArr[] = {
    callBack_receiveFloat,     //slaveCallbackIndex 0
    callBack_receiveInt,       //slaveCallbackIndex 1
    callBack_receiveByte,      //slaveCallbackIndex 2
    callBack_receiveCharArray  //slaveCallbackIndex 3
};
uint8_t callbackLength = sizeof(callbackArr)/sizeof(functionPtr);

void startReturn() {
    for (int i = 0; i < NR_OF_EFFECTS; i++) effects[i]->play(false);
    feelix.setVelocityLimit(10.0);
    returnStart = millis();
    mode = MODE_RETURN;
}

void resetStallWatch() {
    stallRefDeg = feelix.angleDeg;
    stallRefTime = millis();
}

void setup() {
    delay(250);
    Serial.begin(115200);
    
    feelix.bldc->sensor_direction = Direction::CCW;      // or Direction::CW, as read from Feelix
    feelix.bldc->zero_electric_angle = 2.2269563674;   // replace with YOUR value

    feelix.init();
    delay(100);

    for (int i = 0; i < NR_OF_EFFECTS; i++) effects[i]->infinite = true;

    feelix.init_I2C_Slave(
        SLAVE_0_ADDRESS,
        SLAVE_INDEX,
        false,                  // library debug OFF: no Serial prints inside the callbacks
        callbackArr,
        callbackLength);

    resetStallWatch();

}

void loop() {

    feelix.run();   // must run at high frequency without interruptions

    /* fast movement detected: torque effect from the position the shaft is in right now */
    if (fastFlag && mode != MODE_TORQUE) {
        for (int i = 0; i < NR_OF_EFFECTS; i++) effects[i]->play(false);
        torqueAnchorDeg = feelix.angleDeg;
        feelix.setVelocityLimit(22.0);
        mode = MODE_TORQUE;
    }
    /* fast movement over: go to the middle of the range before the velocity effect resumes */
    else if (!fastFlag && mode == MODE_TORQUE) {
        for (int i = 0; i < NR_OF_EFFECTS; i++) effects[i]->play(false);
        feelix.setVelocityLimit(10.0);
        returnStart = millis();
        mode = MODE_RETURN;
    }

    if (mode == MODE_TORQUE) {

        effect2.play(true, (long) feelix.current_time);
        feelix.playHapticEffectAtAngle(effect2, -10.0);
        feelix.move_feelix();

    } else if (mode == MODE_RETURN) {

        feelix.move_feelix((HOME_DEG + MID_OFFSET_DEG) * PI / 180.0, MotionControlType::angle);

        if (fabs(feelix.angleDeg - (HOME_DEG + MID_OFFSET_DEG)) < RETURN_TOLERANCE ||
            millis() - returnStart > RETURN_TIMEOUT_MS) {
            feelix.setVelocityLimit(22.0);
            resetStallWatch();      // <- new: restart the stall timer when the velocity effect resumes
            mode = MODE_VELOCITY;
        }
        

    } else {

        /* pitch -> scale, smoothed so the effect doesn't jump */
        float p = constrain(fabs((float) pitch) / PITCH_FULL, 0.0, 1.0);
        float target = SCALE_MIN + (SCALE_MAX - SCALE_MIN) * p;
        scaleNow = 0.95 * scaleNow + 0.05 * target;
        applyScale(scaleNow);

        effect0.play(true, (long) feelix.current_time);
        feelix.playVelocityEffect(effect0);
        feelix.move_feelix();
    }

    if ((millis() - prevTime) >= timeInterval) {
        prevTime = millis();
        feelix.blinkStatusLED();

        if (DEBUG) {
            Serial.println((String)
                "mode: " + (mode == MODE_VELOCITY ? "velocity" : mode == MODE_TORQUE ? "torque" : "return") +
                "\tangleDeg: " + feelix.angleDeg +
                "\tpitch: " + pitch +
                "\tvelocity: " + feelix.velocity);

            Serial.print("sensor_direction: ");
            Serial.print((int) feelix.bldc->sensor_direction);
            Serial.print("\tzero_electric_angle: ");
            Serial.println(feelix.bldc->zero_electric_angle, 10);    
        }
    }
}